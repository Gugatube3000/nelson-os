{
  "name": "nelson-os",
  "version": "1.0.0",
  "private": true,
  "description": "Nelson OS: construction operations agent for Nelson Group (Greater Boston).",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node scripts/launch.mjs",
    "server": "node --disable-warning=ExperimentalWarning server/index.js",
    "setup": "node scripts/setup.mjs",
    "update": "node scripts/update.mjs",
    "uninstall-nelson-os": "node scripts/uninstall.mjs",
    "mcp": "node --disable-warning=ExperimentalWarning mcp/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "htm": "^3.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  }
}
